<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rule for Clover Terminal -->
        <record id="clover_terminal_company_rule" model="ir.rule">
            <field name="name">Clover Terminal Multi-Company</field>
            <field name="model_id" ref="model_clover_terminal"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-company rule for Clover Transaction -->
        <record id="clover_transaction_company_rule" model="ir.rule">
            <field name="name">Clover Transaction Multi-Company</field>
            <field name="model_id" ref="model_clover_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
