<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clover Terminal Form View -->
    <record id="view_clover_terminal_form" model="ir.ui.view">
        <field name="name">clover.terminal.form</field>
        <field name="model">clover.terminal</field>
        <field name="arch" type="xml">
            <form string="Clover Terminal">
                <header>
                    <field name="is_paired" invisible="1"/>
                    <button name="action_verify_and_pair"
                            string="Verify &amp; Connect Terminal"
                            type="object"
                            class="btn-primary"
                            icon="fa-check-circle"
                            invisible="connection_mode != 'snpd'"/>
                    <button name="action_send_test_payment"
                            string="Test £0.01 Sale"
                            type="object"
                            class="btn-success"
                            icon="fa-credit-card"
                            invisible="connection_mode != 'snpd' or not is_paired"/>
                    <button name="action_unpair_terminal"
                            string="Clear Token"
                            type="object"
                            class="btn-secondary"
                            icon="fa-trash"
                            invisible="connection_mode != 'snpd' or not is_paired"
                            confirm="Are you sure you want to clear the pairing token?"/>
                    <button name="action_test_terminal_connection"
                            string="Ping Device"
                            type="object"
                            class="oe_highlight"
                            icon="fa-wifi"/>
                    <field name="last_status" widget="badge"
                           decoration-success="last_status and 'Online' in last_status"
                           decoration-danger="last_status and ('Error' in last_status or 'Rejected' in last_status)"/>
                </header>
                <sheet>
                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert" invisible="connection_mode != 'snpd' or is_paired">
                        <div>
                            <strong>How to pair:</strong> On your Clover Flex, open <strong>Secure Network Pay Display</strong>. Look at the text below the QR code (or scan the QR code), paste the <strong>authenticationToken</strong> (or the full URL) into <strong>Master Auth Token / QR URL</strong> below, and click <strong>Verify &amp; Connect Terminal</strong>.
                        </div>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Counter 1 - Clover Flex"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Hardware Specifications">
                            <field name="device_serial" placeholder="e.g. C143EQ202030587"/>
                            <field name="model"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Connection Setup">
                            <field name="connection_mode" widget="radio"/>
                            <field name="ip_address"
                                   invisible="connection_mode == 'cloud'"
                                   required="connection_mode in ('lan', 'snpd')"
                                   placeholder="e.g. 192.168.10.95"/>
                            <field name="port"
                                   invisible="connection_mode == 'cloud'"
                                   required="connection_mode in ('lan', 'snpd')"/>
                            <field name="use_https"
                                   invisible="connection_mode == 'cloud'"/>
                            <field name="pairing_auth_token"
                                   invisible="connection_mode != 'snpd'"
                                   placeholder="Paste 36-character token or full wss:// URL from Clover screen"/>
                        </group>
                    </group>
                    <group>
                        <group string="Diagnostics">
                            <field name="last_heartbeat"/>
                            <field name="notes" placeholder="Notes on location, Wi-Fi network, etc."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Clover Terminal List View (Odoo 20 <list> standard) -->
    <record id="view_clover_terminal_list" model="ir.ui.view">
        <field name="name">clover.terminal.list</field>
        <field name="model">clover.terminal</field>
        <field name="arch" type="xml">
            <list string="Clover Terminals">
                <field name="name"/>
                <field name="device_serial"/>
                <field name="model"/>
                <field name="connection_mode"/>
                <field name="ip_address"/>
                <field name="is_paired" widget="boolean_toggle"/>
                <field name="last_status" widget="badge"
                       decoration-success="last_status and 'Online' in last_status"
                       decoration-danger="last_status and ('Error' in last_status or 'Rejected' in last_status)"/>
                <field name="last_heartbeat"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action for Clover Terminals -->
    <record id="action_clover_terminal" model="ir.actions.act_window">
        <field name="name">Clover Terminals</field>
        <field name="res_model">clover.terminal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a Clover Terminal
            </p>
            <p>
                Add your Clover Flex or Mini device serial number to enable cloud payments.
            </p>
        </field>
    </record>

    <!-- Clover Subheading under POS Configuration -->
    <menuitem id="menu_clover_root"
              name="Clover"
              parent="point_of_sale.menu_point_config_product"
              sequence="100"/>

    <!-- Clover Terminals Menu -->
    <menuitem id="menu_clover_terminal"
              name="Terminals"
              parent="menu_clover_root"
              action="action_clover_terminal"
              sequence="1"/>

</odoo>
