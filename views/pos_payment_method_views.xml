<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_clover" model="ir.ui.view">
        <field name="name">pos.payment.method.form.clover</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Payment Terminal">
                    <field name="use_payment_terminal"/>
                </group>
                <group string="Clover Terminal Configuration"
                       invisible="use_payment_terminal != 'clover_cloud'">
                    <field name="clover_terminal_mode" invisible="1"/>
                    <group string="Device Selection">
                        <field name="clover_terminal_id"
                               required="use_payment_terminal == 'clover_cloud'"/>
                    </group>
                    <group string="Cloud Gateway Setup"
                           invisible="clover_terminal_mode != 'cloud'">
                        <field name="clover_environment"
                               required="use_payment_terminal == 'clover_cloud' and clover_terminal_mode == 'cloud'"/>
                        <field name="clover_merchant_id"
                               placeholder="e.g. 13-character merchant ID (Optional)"/>
                        <field name="clover_api_token"
                               password="True"
                               placeholder="Clover OAuth Bearer Token"
                               required="use_payment_terminal == 'clover_cloud' and clover_terminal_mode == 'cloud'"/>
                    </group>
                    <group string="Terminal Behavior">
                        <field name="clover_allow_tip"/>
                        <field name="clover_auto_print_receipt"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
